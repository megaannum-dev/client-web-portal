# TEMPORARY (~1 month, added 2026-10-06): serve the public website on silverwater-cm.com.
# Remove this block (and the silverwater-cm.com DNS records) when the period ends.
silverwater-cm.com {
	encode zstd gzip
	reverse_proxy company-website:3000
}

www.silverwater-cm.com {
	redir https://silverwater-cm.com{uri}
}

megaannum-am.com {
	encode zstd gzip
	reverse_proxy company-website:3000
}

www.megaannum-am.com {
	redir https://megaannum-am.com{uri}
}

crm.megaannum-am.com {
	encode zstd gzip
	reverse_proxy admin-frontend:3000
}

clientportal.megaannum-am.com {
	encode zstd gzip
	reverse_proxy client-frontend:3000
}

api.megaannum-am.com {
	encode zstd gzip
	reverse_proxy api-backend:8000
}

cms.megaannum-am.com {
    encode zstd gzip

    handle /api/* {
        reverse_proxy cms-backend:8001
    }

    handle {
        reverse_proxy cms-frontend:3030
    }
}