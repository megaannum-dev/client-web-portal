megaannum-am.com {
	encode zstd gzip
	reverse_proxy company-website:3000
}

www.megaannum-am.com {
	redir https://megaannum-am.com{uri}
}

crm.megaannum-am.com {
	encode zstd gzip
	reverse_proxy admin-frontend:3000
}

clientportal.megaannum-am.com {
	encode zstd gzip
	reverse_proxy client-frontend:3000
}

api.megaannum-am.com {
	encode zstd gzip
	reverse_proxy api-backend:8000
}

cms.megaannum-am.com {
    encode zstd gzip

    handle /api/* {
        reverse_proxy cms-backend:8001
    }

    handle {
        reverse_proxy cms-frontend:3030
    }
}