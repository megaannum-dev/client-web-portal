BOOTSTRAP_ADMIN_EMAIL=developer@megaannum.ai
BOOTSTRAP_ADMIN_NAME=Super Admin

# Set production-safe values in the real .env on the server.
# Do not commit .env files containing secrets.
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=portal
MARIADB_USER=portal
MARIADB_PASSWORD=change-me
CORS_ORIGINS=https://admin.example.com,https://client.example.com
API_PORT=8000
ADMIN_PORT=3001
CLIENT_PORT=3000

# Firebase Admin credentials: use either JSON content or a mounted file path.
FIREBASE_PROJECT_ID=client-web-portal-2026
FIREBASE_CREDENTIALS_PATH=/secrets/firebase.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_AUTH_DISABLED=false

# Frontend build-time values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
