BOOTSTRAP_ADMIN_EMAIL=developer@megaannum.ai
BOOTSTRAP_ADMIN_NAME=Super Admin

# Local backend Docker Compose defaults.
MARIADB_ROOT_PASSWORD=rootsecret
MARIADB_DATABASE=portal
MARIADB_USER=portal
MARIADB_PASSWORD=portalsecret
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Firebase Admin credentials: use either JSON content or the mounted file path.
FIREBASE_PROJECT_ID=client-web-portal-2026
FIREBASE_CREDENTIALS_PATH=/secrets/firebase.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_AUTH_DISABLED=false
DEV_MODE=false

PC_PERIOD_OPEN_DAYS_BEFORE_END=9
